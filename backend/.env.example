# ─── Copy to .env and fill in real values. NEVER commit .env. ──────────────────

# API server
NODE_ENV=development
PORT=3000

# Supabase (from your Supabase project: Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key bypasses RLS — server-side ONLY, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Added in later phases (placeholders for reference) ────────────────────────
# Phase 4 — Mux (live video)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
# Phase 6 — LiveKit (audio rooms)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# Phase 8 — Upstash Redis (cache / rate limit)
# REDIS_URL=
