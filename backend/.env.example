# --- Copy to .env and fill in real values. NEVER commit .env or put secrets here. ---

# API server
NODE_ENV=development
PORT=3000

# Supabase -- from your project's Settings -> API  (and Settings -> API Keys)
SUPABASE_URL=
# "Publishable key" (sb_publishable_...) -- safe for client use; replaces the old anon key.
SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...) -- bypasses RLS; SERVER-SIDE ONLY, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Settings -> Database) -- used by the migration CLI.
# Replace [YOUR-PASSWORD] with your DB password, URL-encoding special chars
# (e.g. # -> %23, ! -> %21, @ -> %40).
SUPABASE_DB_URL=

# --- Phase 1 -- OAuth providers (only needed for LOCAL `supabase start`) ------
# In the hosted projects these are configured in the dashboard instead
# (Authentication -> Providers). Leave blank for local email/password testing.
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=

# --- Added in later phases (placeholders for reference) -----------------------
# Phase 4 -- Mux (live video)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
# Phase 6 -- LiveKit (audio rooms)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# Phase 3+ -- Upstash Redis (playback-progress buffer; cache/rate-limit later)
# Optional: unset = direct Postgres UPSERT fallback. Format: rediss://default:<pass>@<host>:<port>
REDIS_URL=

# --- AI Bible agent -- NVIDIA-hosted Qwen (OpenAI-compatible API) -------------
# Get a free key at https://build.nvidia.com (starts with "nvapi-"). Required for /agent/ask.
NVIDIA_API_KEY=
# OpenAI-compatible base URL (default shown). Override only if NVIDIA changes it.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id from build.nvidia.com (e.g. qwen/qwen3.5-397b-a17b, qwen/qwen3-235b-a22b).
NVIDIA_MODEL=qwen/qwen3.5-397b-a17b

# --- Phase 4 -- Cloudflare Stream (live + on-demand video) -------------------
# All optional: when CLOUDFLARE_STREAM_API_TOKEN is unset, /streams returns 503
# and the rest of the API is unaffected.
CLOUDFLARE_ACCOUNT_ID=
# API token scoped to Stream (Stream Read + Stream Edit). Server-side only.
CLOUDFLARE_STREAM_API_TOKEN=
# The "customer-<CODE>" playback subdomain (from any Stream playback URL).
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Signed playback (private streams): from POST /stream/keys. PEM is base64-encoded.
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=
# From the PUT /stream/webhook response — verifies the video-ready webhook signature.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
