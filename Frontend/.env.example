# Expo public env (safe to ship in the app bundle). Copy to .env for local dev.
# Expo only exposes vars prefixed with EXPO_PUBLIC_.

# Backend API base URL (NestJS). Include the /api/v1 prefix.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase (Phase 1 auth). From your project's Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable / anon key (sb_publishable_...). Safe on the client.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth 2.0 **Web** client ID (Google Cloud Console -> Credentials).
# Same ID must be listed in Supabase -> Auth -> Providers -> Google -> Client IDs.
# An Android OAuth client (package com.bibleway.app + your SHA-1) must also exist
# in the same Google Cloud project, but its ID is NOT used here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
