    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
